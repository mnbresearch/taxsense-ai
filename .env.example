# Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables (mark secrets "Sensitive").

# ---- LLM (conversational intake) ----
# Default provider: Groq. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=
# Backup provider: Anthropic (optional). Disclosed in the privacy policy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Extra OpenAI-compatible fallback (optional). Add the provider to /privacy BEFORE setting these.
LLM_FALLBACK_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=
# Force a provider: groq | anthropic | mock  (mock = zero-key demo mode)
INTAKE_PROVIDER=

# ---- Supabase (auth + storage) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin ----
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# ---- Email (Resend) ----
RESEND_API_KEY=
# HMAC key for one-click unsubscribe links (any long random string)
UNSUBSCRIBE_SECRET=

# ---- Cron ----
# Required: /api/cron/* refuses every request without it. Vercel Cron sends it automatically.
CRON_SECRET=

# ---- Payments (Cashfree) ----
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox
